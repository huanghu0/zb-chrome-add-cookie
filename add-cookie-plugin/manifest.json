{
    "manifest_version": 3,  
    "name": "Token 注入 Cookie 工具",
    "version": "1.0",
    "description": "自定义 Token 名称和值，快速注入当前域名 Cookie",
    "permissions": [
      "cookies",  
      "activeTab"
    ],
    "action": {
      "default_popup": "popup.html", 
      "default_icon": "icon.png"
    },
    "host_permissions": [
      "<all_urls>"
    ],    
    "icons": {
      "128": "icon.png"
    }
}